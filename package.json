{
  "name": "vidgen",
  "version": "1.4.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DATABASE_V2 --remote",
    "db:migrate:local": "wrangler d1 migrations apply DATABASE_V2 --local",
    "db:migrate:remote": "wrangler d1 migrations apply DATABASE_V2 --remote",
    "cf:check": "wrangler deploy --dry-run",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.102.0"
  }
}
