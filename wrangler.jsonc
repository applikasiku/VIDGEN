// Cloudflare build trigger: VIDGEN v1.0.4 current config
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vidgen",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  "d1_databases": [
    {
      "binding": "DATABASE_V2",
      "database_name": "vidgen-db",
      "database_id": "a6820a65-b3e8-432b-aa7b-a29c2e205672"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE_V2",
      "bucket_name": "vidgen-media"
    }
  ],
  "vars": {
    "APP_NAME": "VIDGEN",
    "APP_ENV": "production",
    "APP_VERSION": "1.0.4",
    "GOOGLE_DRIVE_FOLDER": "VIDGEN",
    "LUMA_MODEL": "ray-2",
    "VEO_MODEL": "veo-3.1-generate-001",
    "VEO_LOCATION": "us-central1",
    "SEEDANCE_MODEL": "doubao-seedance-1-5-pro-251215"
  }
}

