// Cloudflare build trigger: VIDGEN v1.4.4 current config
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vidgen",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*", "/provider-media/*"]
  },
  "d1_databases": [
    {
      "binding": "DATABASE_V2",
      "database_name": "vidgen-db",
      "database_id": "a6820a65-b3e8-432b-aa7b-a29c2e205672"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE_V2",
      "bucket_name": "vidgen-media"
    }
  ],
  "vars": {
    "APP_NAME": "VIDGEN",
    "APP_ENV": "production",
    "APP_VERSION": "1.4.4",
    "GOOGLE_DRIVE_FOLDER": "VIDGEN",
    "LUMA_MODEL": "ray-2",
    "RUNWAY_API_BASE": "https://api.dev.runwayml.com/v1",
    "RUNWAY_MODEL": "gen4.5",
    "SEEDANCE_API_BASE": "https://operator.las.ap-southeast-1.bytepluses.com",
    "GOOGLE_AI_API_BASE": "https://generativelanguage.googleapis.com/v1beta",
    "GOOGLE_AI_DEFAULT_MODEL": "veo-3.1-generate-preview",
    "SEEDANCE_MODEL": "dreamina-seedance-2-0-260128"
  }
}

